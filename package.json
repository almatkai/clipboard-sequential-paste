{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "clipboard-sequential-paste",
  "title": "Clipboard Sequential Paste",
  "description": "Copy a list to your clipboard and paste items one by one.",
  "icon": "assets/extension-icon.png",
  "author": "almatkai",
  "license": "MIT",
  "commands": [
    {
      "name": "paste-next-item",
      "title": "Paste Next Item",
      "description": "Pastes the next item from your copied list.",
      "mode": "no-view",
      "platforms": [
        "macOS",
        "Windows"
      ]
    }
  ],
  "categories": [
    "Productivity"
  ],
  "dependencies": {
    "@raycast/api": "^1.104.1",
    "@raycast/utils": "^2.2.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "ray build -e dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "id": "com.tezbar.clipboard-sequential-paste",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "version": "0.1.0",
  "tezbar": {
    "schemaVersion": 1,
    "platforms": [
      "macos",
      "windows"
    ],
    "linuxStatus": "coming-soon",
    "repository": "https://github.com/almatkai/clipboard-sequential-paste",
    "upstream": {
      "repository": "https://github.com/raycast/extensions",
      "path": "extensions/clipboard-sequential-paste",
      "commit": "6734d85992290066fd31a7f5bee3cca3d3545a1a"
    }
  }
}
